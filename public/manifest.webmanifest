{
  "name": "RefPin — Academic PDF Reader",
  "short_name": "RefPin",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F7F6F3",
  "theme_color": "#1C1917",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      }
    }
  ]
}
